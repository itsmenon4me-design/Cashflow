# ============================================================
# CashFlow Production environment template
# Copy to docker/.env and fill with real values.
# NEVER commit real secrets.
# ============================================================

# --- App / network ---
COMPOSE_PROJECT_NAME=cashflow
API_PREFIX=api
API_VERSION=v1
HOST=0.0.0.0
APP_PORT=3001
FRONTEND_PORT=3000

# --- PostgreSQL (internal only) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=cashflow
# Host "postgres" = compose internal network
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/cashflow?schema=public
DATABASE_SCHEMA=public

# --- Redis (internal only). Set a password; REDIS_URL must match. ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
# With password:  redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# --- JWT (REQUIRED in production; generate with `openssl rand -hex 64`) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# --- CORS / frontend ---
CORS_ORIGIN=https://your-domain.com
# Frontend API base (baked into the Next.js build). Same origin is served by Nginx.
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# --- Seed: keep OFF in production to avoid creating a default admin ---
SEED_ENABLED=false

# --- MinIO (internal only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001