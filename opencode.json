{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cashflow-postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "--network",
        "cashflow_internal",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted"
      ],
      "environment": {
        "DATABASE_URI": "{env:CASHFLOW_MCP_DATABASE_URI}"
      }
    }
  }
}	