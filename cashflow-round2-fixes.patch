+    page,
+    pageSize,
+    sort.key,
+    sort.order,
+    search,
+    queryConfig,
+    accountNames,
+    categoryNames,
+    activeCurrency,
+  ]);
+
+  const refresh = () => setRefreshKey((key) => key + 1);
+
+  const categoryOptions = useMemo(
