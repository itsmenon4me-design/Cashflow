+      });
+    };
+
+    void load();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [activeCurrency, dataVersion]);
+
+  // Use the locale-provided guest label instead of a fragile string-comparison
+  // check on uiText.common.quickAdd, which broke language fallback and could
