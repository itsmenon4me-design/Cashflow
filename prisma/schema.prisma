generator client {
  provider = "prisma-client-js"
  output   = "../apps/backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Base model convention: UUID primary key, createdAt, updatedAt
// Initial placeholder model only
model SystemHealth {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  deleted_at      DateTime? @db.Timestamptz

  email           String   @unique
  username        String   @unique
  full_name       String
  password_hash   String
  avatar_url      String?  
  phone_number    String?
  status          String
  email_verified_at DateTime? @db.Timestamptz
  last_login_at   DateTime? @db.Timestamptz

  // Email verification fields
  verification_token_hash String?  
  verification_token_expires_at DateTime? @db.Timestamptz

  // Password reset fields
  password_reset_token_hash String? 
  password_reset_expires_at DateTime? @db.Timestamptz
  password_reset_requested_at DateTime? @db.Timestamptz

role_id String? @db.Uuid
  role            Role?    @relation(fields: [role_id], references: [id])

refresh_tokens  RefreshToken[]
sessions        Session[]

// Finance modules
accounts        Account[]
categories      Category[]
transactions    Transaction[]
bills           Bill[]
audit_logs      AuditLog[]
budgets         Budget[]
savingGoals     SavingGoal[]
investments     Investment[]
notifications   Notification[]
userSettings    UserSettings?

@@map("users")
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  description String?
  is_system  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String
  expires_at DateTime
  revoked_at DateTime? @db.Timestamptz
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
  sessions Session[]

  @@index([user_id])
  @@map("refresh_tokens")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String   @db.Uuid
  refresh_token_id String   @db.Uuid
  device_name      String?
  device_type      String?
  browser          String?
  operating_system String?
  ip_address       String?
  user_agent       String?
  last_activity_at DateTime
  expires_at       DateTime
  revoked_at       DateTime? @db.Timestamptz
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
  refreshToken RefreshToken @relation(fields: [refresh_token_id], references: [id])

  @@index([user_id])
  @@index([refresh_token_id])
  @@map("sessions")
}

model Permission {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  description String?
  module     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model AuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String?   @db.Uuid
  user User? @relation(fields: [user_id], references: [id])
  action          String
  module          String
  description     String?
  entity_type     String?
  entity_id       String?   @db.Uuid
  ip_address      String?
  user_agent      String?
  request_method  String?
  request_path    String?
  response_status Int?
  metadata        Json?
  created_at      DateTime  @default(now())

  @@index([user_id])
  @@index([action])
  @@index([module])
  @@index([created_at])
  @@map("audit_logs")
}

model HistoricalRecoveryLedger {
  id                 String    @id @default(uuid()) @db.Uuid
  recovery_id        String    @unique
  finding_id         String
  entity_type        String
  entity_id          String
  user_id            String
  currency           String
  status             String
  before_value_cents BigInt    @db.BigInt
  after_value_cents  BigInt    @db.BigInt
  approved_by        String?
  executed_by        String?
  rolled_back_by     String?
  rollback_status    String?
  source_fingerprint String
  evidence           Json?
  error_reason       String?
  approved_at        DateTime? @db.Timestamptz
  executed_at        DateTime? @db.Timestamptz
  rolled_back_at     DateTime? @db.Timestamptz
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([entity_type, entity_id])
  @@map("historical_recovery_ledger")
}

// Account model
model Account {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  name               String
  account_type       String
  currency           String   @default("IDR")
  opening_balance_cents BigInt @default(0) @db.BigInt
  current_balance_cents BigInt @default(0) @db.BigInt
  color              String?
  icon               String?
  description        String?
  is_active          Boolean  @default(true)
  is_default         Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted_at         DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  transactions Transaction[]
  bills Bill[]
  savingGoals SavingGoal[]
  investments Investment[]

  @@index([user_id])
  @@unique([user_id, name])
  @@map("accounts")
}
// Category model
model Category {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  name               String
  type               String
  icon               String?
  color              String?
  description        String?
  parent_category_id String?  @db.Uuid
  is_system          Boolean  @default(false)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted_at         DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])
  parent Category? @relation("CategoryToParent", fields: [parent_category_id], references: [id])
  children Category[] @relation("CategoryToParent")

  transactions Transaction[]
  bills Bill[]
  budgets Budget[]
  savingGoals SavingGoal[]

  @@index([user_id])
  @@unique([user_id, name, type])
  @@map("categories")
}

// Bill model
enum BillRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Bill {
  id                   String          @id @default(uuid()) @db.Uuid
  user_id              String          @db.Uuid
  payee                String
  amount_cents         BigInt          @db.BigInt
  currency             String          @default("IDR")
  account_id           String?         @db.Uuid
  category_id          String?         @db.Uuid
  due_date             DateTime
  due_date_timezone    String?
  is_paid              Boolean         @default(false)
  paid_at              DateTime?       @db.Timestamptz
  transaction_id       String?         @db.Uuid
  status               String          @default("OPEN")
  recurrence_type      BillRecurrence  @default(NONE)
  recurrence_interval  Int?
  recurrence_ends_at   DateTime?
  series_id            String?         @db.Uuid
  is_template          Boolean         @default(false)
  reminder_enabled     Boolean         @default(false)
  reminder_days_before Int?
  reminder_time        String?
  reminder_config      Json?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  deleted_at           DateTime?       @db.Timestamptz

  user     User      @relation(fields: [user_id], references: [id])
  account  Account?  @relation(fields: [account_id], references: [id])
  category Category? @relation(fields: [category_id], references: [id])
  transaction Transaction? @relation(fields: [transaction_id], references: [id])
  series Bill? @relation("BillSeries", fields: [series_id], references: [id])
  seriesMembers Bill[] @relation("BillSeries")

  @@index([user_id])
  @@index([user_id, due_date])
  @@index([user_id, is_paid])
  @@index([series_id])
  @@index([category_id])
  @@index([account_id])
  @@unique([transaction_id])
  @@unique([series_id, due_date])
  @@map("Bill")
}

model Budget {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  category_id        String   @db.Uuid
  budget_amount_cents BigInt  @db.BigInt
  month              Int
  year               Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted_at         DateTime? @db.Timestamptz

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  @@index([user_id])
  @@index([category_id])
  @@map("budgets")
}

model SavingGoal {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  account_id         String?  @db.Uuid
  category_id        String?  @db.Uuid
  name               String
  description        String?
  target_amount_cents BigInt  @db.BigInt
  current_amount_cents BigInt @default(0) @db.BigInt
  start_date         DateTime
  target_date        DateTime
  status             String   @default("ACTIVE")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted_at         DateTime? @db.Timestamptz

  user     User      @relation(fields: [user_id], references: [id])
  account  Account?  @relation(fields: [account_id], references: [id])
  category Category? @relation(fields: [category_id], references: [id])

  @@index([user_id])
  @@index([account_id])
  @@index([category_id])
  @@map("saving_goals")
}

model Investment {
  id                    String   @id @default(uuid()) @db.Uuid
  user_id               String   @db.Uuid
  account_id            String?  @db.Uuid
  investment_type       String
  platform              String
  name                  String
  symbol                String?
  quantity              Decimal  @db.Decimal(20, 8)
  average_buy_price     Decimal  @db.Decimal(20, 6)
  current_price         Decimal  @db.Decimal(20, 6)
  invested_amount_cents BigInt   @db.BigInt
  current_value_cents   BigInt   @db.BigInt
  profit_loss_cents     BigInt   @db.BigInt
  profit_loss_percentage Decimal @db.Decimal(10, 2)
  purchase_date         DateTime
  notes                 String?
  status                String   @default("ACTIVE")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  deleted_at            DateTime? @db.Timestamptz

  user    User     @relation(fields: [user_id], references: [id])
  account Account? @relation(fields: [account_id], references: [id])

  @@index([user_id])
  @@index([account_id])
  @@map("investments")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  type       String
  title      String
  message    String
  is_read    Boolean  @default(false)
  read_at    DateTime? @db.Timestamptz
  dedupe_key String?
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([user_id, is_read])
  @@index([created_at])
  @@unique([user_id, dedupe_key])
  @@map("notifications")
}

model UserSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  user_id                String   @db.Uuid
  theme                  String   @default("system")
  language               String   @default("id")
  currency               String   @default("IDR")
  timezone               String?
  notification_preferences Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id])
  @@index([user_id])
  @@map("user_settings")
}

// Transaction model
enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @db.Uuid
  account_id        String   @db.Uuid
  category_id       String   @db.Uuid

  transaction_type  TransactionType

  amount_cents      BigInt   @db.BigInt
  transaction_date  DateTime
  note              String?
  reference_number  String?
  attachment_url    String?
  location          String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  deleted_at        DateTime? @db.Timestamptz
  transfer_group_id String? @db.Uuid
  transfer_reference String?

  user     User     @relation(fields: [user_id], references: [id])
  account  Account  @relation(fields: [account_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  bills Bill[]

  @@index([user_id])
  @@index([account_id])
  @@index([category_id])
  @@index([transfer_group_id])
  @@map("transactions")
}