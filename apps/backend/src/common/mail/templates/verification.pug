doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title Verify your email
  body
    h1 Hello #{name}
    p Please click the link below to verify your email address:
    p
      a(href='#{link}') Verify Email
    p This link will expire in 24 hours.
    p If you did not request this, please ignore this email.
