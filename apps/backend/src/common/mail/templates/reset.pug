doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    title Password reset
  body
    h1 Hello #{name}
    p A request to reset your password was received. Click the link below to proceed:
    p
      a(href='#{link}') Reset Password
    p This link will expire in 30 minutes.
    p If you did not request this, please ignore this email.
