# ============================================================
# CashFlow Backend environment template (tracked example — no secrets)
# Copy to .env.<NODE_ENV> (e.g. .env.production) and fill real values.
# Production template: see docker/.env.example
# ============================================================

# Application
NODE_ENV=development
APP_NAME=CashFlow Enterprise
APP_PORT=3001
APP_URL=http://localhost:3001
API_PREFIX=api
API_VERSION=v1
TZ=Asia/Jakarta
APP_LOCALE=id-ID
LOG_LEVEL=debug

# Database (placeholder)
DATABASE_URL=
DATABASE_SCHEMA=public
DATABASE_LOGGING=false

# Redis (placeholder)
REDIS_URL=
REDIS_TTL_SECONDS=60

# JWT (placeholder — REQUIRED in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# CORS / Security (placeholder)
# Production: CORS_ORIGIN=https://your-domain.com
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
SECURITY_HELMET=true
SECURITY_CORS=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100

# Auth-specific rate limit settings
# Login is strict to prevent password brute-force
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=60
# Registration slightly more permissive
AUTH_REGISTER_LIMIT=10
AUTH_REGISTER_WINDOW_SECONDS=60
# Refresh token rotation should be protected but allow normal usage
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=60
# Identifier-based failed-login lock (per email hash)
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SECONDS=3600

# Rate limit for SUPER_ADMIN audit-log read endpoints (per admin identity + path)
AUDIT_ADMIN_RATE_LIMIT_LIMIT=120
AUDIT_ADMIN_RATE_LIMIT_TTL_SECONDS=60

# Proxy / forwarding configuration
# Set to true when running behind a trusted reverse proxy (e.g., Nginx or Cloudflare) so the app will use X-Forwarded-* headers for client IPs
TRUST_PROXY=false
# Production: SECURE_COOKIES=true
SECURE_COOKIES=false

# Swagger (keep false in production unless intentionally exposed)
SWAGGER_ENABLED=false
SWAGGER_TITLE=CashFlow Enterprise API
SWAGGER_DESCRIPTION=CashFlow Enterprise API documentation
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Seed (production must stay false; dev optional true)
SEED_ENABLED=false

# SMTP / Mail (optional, placeholders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.com
EMAIL_VERIFICATION_ENABLED=false
PASSWORD_RESET_ENABLED=true
