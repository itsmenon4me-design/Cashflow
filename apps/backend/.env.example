# Application
NODE_ENV=development
APP_NAME=CashFlow Enterprise
APP_PORT=3001
APP_URL=http://localhost:3001
API_PREFIX=api
API_VERSION=v1
TZ=Asia/Jakarta
APP_LOCALE=id-ID
LOG_LEVEL=debug

# Database (placeholder)
DATABASE_URL=
DATABASE_SCHEMA=public
DATABASE_LOGGING=false

# Redis (placeholder)
REDIS_URL=
REDIS_TTL_SECONDS=60

# JWT (placeholder)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# CORS / Security (placeholder)
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
SECURITY_HELMET=true
SECURITY_CORS=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
SECURE_COOKIES=false

# Swagger (placeholder)
SWAGGER_ENABLED=false
SWAGGER_TITLE=CashFlow Enterprise API
SWAGGER_DESCRIPTION=CashFlow Enterprise API documentation
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs